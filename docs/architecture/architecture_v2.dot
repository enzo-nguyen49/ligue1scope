digraph V2 {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="Ligue1Scope - Architecture V2 (finale) : batch hebdomadaire, raw rejouable, PostgreSQL + mart pour Power BI\n", pad=0.3, nodesep=0.35, ranksep=0.5, compound=true];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#EEF2FF", color="#4057F5"];
  edge [color="#555555", fontname="Helvetica", fontsize=8];

  subgraph cluster_src { label="Sources"; style="rounded,dashed"; color="#D9822B"; fontcolor="#D9822B";
    fd [label="Football-Data.co.uk\nF1.csv par saison\nresultats, heure, cotes", fillcolor="#FFF4E5", color="#D9822B"];
    om [label="Open-Meteo Archive\nJSON horaire + journalier", fillcolor="#FFF4E5", color="#D9822B"];
    ref [label="config/stadiums.csv\nreferentiel stades", fillcolor="#FFF4E5", color="#D9822B"];
  }
  subgraph cluster_orch { label="src/pipeline.py  (run_id, logs, statut PASS / PASS_WITH_WARNINGS / FAIL)"; style="rounded"; color="#4057F5"; fontcolor="#4057F5";
    col [label="collect.py\nURL ou local, timeout,\nretries, SHA-256"];
    prof [label="profile_data.py\nprofil raw"];
    val [label="validate.py\n11 regles + schema\nquality gate 5 %"];
    tr [label="transform.py\nElo pre-match, proba marche,\nfavoris, meteo, lignage"];
    pub [label="publish.py\necriture atomique\n+ UPSERT transactionnel"];
  }
  cw [label="collect_weather.py\n(a la demande)"];
  subgraph cluster_lake { label="Zone raw (lake leger, fichiers)"; style="rounded"; color="#777777"; fontcolor="#555555";
    raw [label="data/raw/ligue1\nversions horodatees\n+ manifestes", shape=folder, fillcolor="#F4F4F4", color="#777777"];
    raww [label="data/raw/weather\nJSON par stade", shape=folder, fillcolor="#F4F4F4", color="#777777"];
  }
  quar [label="data/rejected/quarantine\nfichiers invalides + motif", shape=folder, fillcolor="#FDECEC", color="#C23B3B"];
  rej [label="data/rejected\nrejected_<run_id>.csv\nlignes + motifs", shape=folder, fillcolor="#FDECEC", color="#C23B3B"];
  subgraph cluster_serve { label="Zone curated + service"; style="rounded"; color="#2E8B57"; fontcolor="#2E8B57";
    cur [label="matches_curated\n.csv + .parquet", shape=folder, fillcolor="#EAF7EE", color="#2E8B57"];
    mart [label="mart/kpi_*.csv\n4 tables de KPI", shape=folder, fillcolor="#EAF7EE", color="#2E8B57"];
    pg [label="PostgreSQL 16\nseason, team, football_match,\nmatch_weather, pipeline_run\nvues v_match_analysis, v_kpi_*", shape=cylinder, fillcolor="#EAF7EE", color="#2E8B57"];
  }
  bi [label="Power BI\n4 pages : vue d'ensemble,\nElo, meteo, club", fillcolor="#FFFFFF"];
  subgraph cluster_obs { label="Observabilite"; style="rounded,dashed"; color="#888888"; fontcolor="#666666";
    obs [label="reports/run_report.json\nquality_report.json\nprofiling_report.json\nrun_history.jsonl, logs/", shape=note, fillcolor="#FFFDE7", color="#B59F00"];
  }
  ci [label="GitHub Actions\npytest + PostgreSQL", shape=component, fillcolor="#FFFFFF", color="#888888"];

  fd -> col; col -> raw; om -> cw; ref -> cw; cw -> raww;
  raw -> prof; prof -> val; raw -> quar [label="schema invalide", style=dashed, color="#C23B3B"];
  val -> rej [label="rejets", color="#C23B3B"]; val -> tr [label="acceptes"];
  raww -> tr; ref -> tr [style=dotted];
  tr -> pub; pub -> cur; pub -> mart; pub -> pg [label="UPSERT"];
  pg -> bi [label="vues"]; cur -> bi [style=dotted, label="alternative"];
  val -> obs [style=dotted]; pub -> obs [style=dotted]; ci -> val [style=dotted, arrowhead=none];
}
